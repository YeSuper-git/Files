<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <AcceptEula>wix7</AcceptEula>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>Files max Setup</OutputName>
    <SuppressPdbOutput Condition="'$(Configuration)' == 'Release'">true</SuppressPdbOutput>

    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\artifacts\installer\msi\Files max Installer.msi</MsiPath>
    <VCRedistPath Condition="'$(VCRedistPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\artifacts\VC_redist.x64.exe</VCRedistPath>
    <AppVersion Condition="'$(AppVersion)' == ''">1.0.0.0</AppVersion>
    <ProductName Condition="'$(ProductName)' == ''">Files max</ProductName>
    <LogoFile Condition="'$(LogoFile)' == ''">$(MSBuildThisFileDirectory)..\..\..\src\Files.App\Assets\AppTiles\Dev\FilesSiameseCatLogo.png</LogoFile>
    <IconFile Condition="'$(IconFile)' == ''">$(MSBuildThisFileDirectory)..\..\..\src\Files.App\Assets\AppTiles\Dev\Logo.ico</IconFile>

    <DefineConstants>
      $(DefineConstants);
      AppVersion=$(AppVersion);
      ProductName=$(ProductName);
      MsiPath=$(MsiPath);
      VCRedistPath=$(VCRedistPath);
      LogoFile=$(LogoFile);
      IconFile=$(IconFile)
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Files.Package.wxs" />
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>
</Project>
