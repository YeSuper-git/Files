<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Id="YeSuper.Files"
      Name="$(var.ProductName)"
      Manufacturer="YeSuper"
      Version="$(var.AppVersion)"
      Scope="perMachine"
      Compressed="yes">

    <SummaryInformation Description="Files max" Manufacturer="YeSuper" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="电脑中已经安装了更新版本的 Files max。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Ask the user to close Files during repair, upgrade, or uninstall so
         the installed binaries are not held open by the running app. -->
    <util:CloseApplication
        Id="CloseFilesApplication"
        Target="Files.exe"
        Description="Files max 正在运行。请先关闭它再继续。"
        PromptToContinue="yes"
        RebootPrompt="no"
        CloseMessage="yes"
        ElevatedCloseMessage="yes"
        Timeout="10" />

    <Icon Id="FilesIcon" SourceFile="$(var.PayloadDir)\Assets\AppTiles\Dev\Logo.ico" />
    <Property Id="ARPPRODUCTICON" Value="FilesIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Files max">
        <Directory Id="INSTALLSUPPORT" Name="Installer" />
      </Directory>
    </StandardDirectory>

    <!-- Use the common Start Menu so the per-machine MSI has a single,
         all-users shortcut and does not mix HKLM data with a user profile. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CommonStartMenuMicrosoftFolder" Name="Microsoft">
        <Directory Id="CommonStartMenuWindowsFolder" Name="Windows">
          <Directory Id="CommonStartMenuFolder" Name="Start Menu">
            <Directory Id="CommonProgramsFolder" Name="Programs">
              <Directory Id="ApplicationProgramsFolder" Name="Files max" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- The entire self-contained Files publish directory is harvested into
         deterministic MSI components. Support files are authored separately
         because the identity registration custom actions need stable File ids. -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)\**">
        <!-- e_sqlite3.dll is language-neutral but carries a file version. Give
             its MSI File row LANGID 0 explicitly to satisfy ICE60. -->
        <Exclude Files="$(var.PayloadDir)\e_sqlite3.dll" />
      </Files>
      <ComponentRef Id="SqliteNativeLibrary" />
    </ComponentGroup>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="SqliteNativeLibrary" Guid="C9DF7897-A4C6-4E69-9BCB-4CFD59A0D530">
        <File Id="SqliteNativeLibraryFile" Source="$(var.PayloadDir)\e_sqlite3.dll" DefaultLanguage="0" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLSUPPORT">
      <Component Id="InstallerSupportFiles" Guid="E2600A42-10A0-4A04-B2AB-3DD40F14734B">
        <File Id="InstallAppScript" Source="$(var.InstallScript)" KeyPath="yes" />
        <File Id="InstallAppLauncherScript" Source="$(var.InstallLauncherScript)" />
        <File Id="IdentityPackageFile" Source="$(var.IdentityPackage)" />
        <File Id="IdentityCertificateFile" Source="$(var.Certificate)" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="B46A0D6F-4BB7-4B31-A6A6-ED0EF6B1A646">
        <Shortcut
            Id="FilesStartMenuShortcut"
            Name="Files max"
            Target="[INSTALLFOLDER]Files.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
            Root="HKLM"
            Key="Software\YeSuper\Files"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Explorer integration is owned by MSI so repair, upgrade and uninstall
         all use the same component model as the rest of the installation. -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="DirectoryShellIntegration" Guid="4206FBB8-4F61-4A9D-92BC-DA0E6C329B03">
        <RemoveFile Id="RemoveLegacyNsisUninstaller" Name="Uninstall.exe" On="install" />
        <RemoveFile Id="RemoveLegacyInstallScript" Name="Install-App.ps1" On="install" />
        <RemoveFile Id="RemoveLegacyIdentityPackage" Name="Files.Identity.msix" On="install" />
        <RemoveFile Id="RemoveLegacyCertificate" Name="Files.cer" On="install" />
        <RemoveFile Id="RemoveLegacyVCRedist" Name="VC_redist.x64.exe" On="install" />
        <RegistryKey Root="HKLM" Key="Software\Classes\Directory\shell\FilesYeSuper">
          <RegistryValue Name="MUIVerb" Value="在 Files max 中打开" Type="string" />
          <RegistryValue Name="Icon" Value="[INSTALLFOLDER]Files.exe" Type="string" />
          <RegistryKey Key="command">
            <RegistryValue Value="&quot;[INSTALLFOLDER]Files.exe&quot; &quot;%1&quot;" Type="string" KeyPath="yes" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\YeSuper\Files">
          <RegistryValue Name="InstallLocation" Value="[INSTALLFOLDER]" Type="string" />
        </RegistryKey>
      </Component>

      <Component Id="DriveShellIntegration" Guid="3ED18D14-8C7B-4D30-9E83-B0874D6DD9ED">
        <RegistryKey Root="HKLM" Key="Software\Classes\Drive\shell\FilesYeSuper">
          <RegistryValue Name="MUIVerb" Value="在 Files max 中打开" Type="string" />
          <RegistryValue Name="Icon" Value="[INSTALLFOLDER]Files.exe" Type="string" />
          <RegistryKey Key="command">
            <RegistryValue Value="&quot;[INSTALLFOLDER]Files.exe&quot; &quot;%1&quot;" Type="string" KeyPath="yes" />
          </RegistryKey>
        </RegistryKey>
      </Component>

      <Component Id="DirectoryBackgroundShellIntegration" Guid="F8CFEE5D-52EC-4FEE-A2BB-C7FE5AE5B5D9">
        <RegistryKey Root="HKLM" Key="Software\Classes\Directory\Background\shell\FilesYeSuper">
          <RegistryValue Name="MUIVerb" Value="在 Files max 中打开" Type="string" />
          <RegistryValue Name="Icon" Value="[INSTALLFOLDER]Files.exe" Type="string" />
          <RegistryKey Key="command">
            <RegistryValue Value="&quot;[INSTALLFOLDER]Files.exe&quot; &quot;%V&quot;" Type="string" KeyPath="yes" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <!-- PowerShell is still used for the Windows external-location identity,
         but it is now invoked by a deferred WiX custom action. This action
         deliberately impersonates the installing user: Add-AppxPackage
         registers the external-location identity per user, so running it as
         LocalSystem would register the package for the wrong account. The
         launcher captures syntax errors before Install-App.ps1 can initialize
         its own diagnostics. The script derives INSTALLFOLDER from its own
         INSTALLSUPPORT location; do not pass a quoted path ending in a slash. -->
    <SetProperty
        Id="RegisterFilesIdentity"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[#InstallAppLauncherScript]&quot; -Mode Install -AttemptId &quot;[INSTALLERATTEMPTID]&quot; -LogFileName &quot;Files max Installer-script.log&quot; -ErrorFileName &quot;Files max Installer-error.log&quot;"
        Before="RegisterFilesIdentity"
        Sequence="execute"
        Condition="NOT Installed OR REINSTALL~=&quot;ALL&quot;" />
    <CustomAction
        Id="RegisterFilesIdentity"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="yes"
        Return="check" />

    <SetProperty
        Id="UnregisterFilesIdentity"
        Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[#InstallAppLauncherScript]&quot; -Mode Uninstall -IdentityVersion &quot;[ProductVersion]&quot; -AttemptId &quot;[INSTALLERATTEMPTID]&quot; -LogFileName &quot;Files max Installer-script.log&quot; -ErrorFileName &quot;Files max Installer-error.log&quot;"
        Before="UnregisterFilesIdentity"
        Sequence="execute"
        Condition="REMOVE=&quot;ALL&quot;" />
    <CustomAction
        Id="UnregisterFilesIdentity"
        BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
        DllEntry="WixQuietExec"
        Execute="deferred"
        Impersonate="yes"
        Return="check" />

    <InstallExecuteSequence>
      <Custom Action="RegisterFilesIdentity" After="InstallFiles" Condition="NOT Installed OR REINSTALL~=&quot;ALL&quot;" />
      <Custom Action="UnregisterFilesIdentity" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="Files max" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="InstallerSupportFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DirectoryShellIntegration" />
      <ComponentRef Id="DriveShellIntegration" />
      <ComponentRef Id="DirectoryBackgroundShellIntegration" />
    </Feature>
  </Package>
</Wix>
