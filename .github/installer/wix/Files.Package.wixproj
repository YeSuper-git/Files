<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <AcceptEula>wix7</AcceptEula>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>Files max Installer</OutputName>
    <SuppressPdbOutput Condition="'$(Configuration)' == 'Release'">true</SuppressPdbOutput>

    <!-- The self-contained .NET publish contains a few native files whose
         embedded language resource is not a valid Windows Installer language
         id. The workflow normalizes this column to language-neutral after the
         MSI is linked, while all other ICE validation remains enabled. -->
    <SuppressIces>ICE03</SuppressIces>

    <!-- WIX1101 is emitted for the language-neutral e_sqlite3.dll because
         its PE version resource has no language block. Keep LANGID 0 on its
         MSI File row (and ICE validation enabled); silence only this known
         metadata warning rather than assigning a misleading language. -->
    <SuppressSpecificWarnings>$(SuppressSpecificWarnings);1101</SuppressSpecificWarnings>

    <!-- These paths are supplied by the Windows build workflow. Keeping them
         as explicit properties prevents WiX from accidentally harvesting a
         local bin/obj directory. -->
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\artifacts\publish</PayloadDir>
    <InstallScript Condition="'$(InstallScript)' == ''">$(MSBuildThisFileDirectory)..\..\..\Install-App.ps1</InstallScript>
    <InstallLauncherScript Condition="'$(InstallLauncherScript)' == ''">$(MSBuildThisFileDirectory)..\..\..\Invoke-Install-App.ps1</InstallLauncherScript>
    <IdentityPackage Condition="'$(IdentityPackage)' == ''">$(MSBuildThisFileDirectory)..\..\..\artifacts\Files.Identity.msix</IdentityPackage>
    <Certificate Condition="'$(Certificate)' == ''">$(MSBuildThisFileDirectory)..\..\..\artifacts\Files.cer</Certificate>
    <AppVersion Condition="'$(AppVersion)' == ''">1.0.0</AppVersion>
    <IdentityVersion Condition="'$(IdentityVersion)' == ''">$(AppVersion).0</IdentityVersion>
    <ProductName Condition="'$(ProductName)' == ''">Files max</ProductName>

    <DefineConstants>
      $(DefineConstants);
      AppVersion=$(AppVersion);
      IdentityVersion=$(IdentityVersion);
      ProductName=$(ProductName);
      PayloadDir=$(PayloadDir);
      InstallScript=$(InstallScript);
      InstallLauncherScript=$(InstallLauncherScript);
      IdentityPackage=$(IdentityPackage);
      Certificate=$(Certificate)
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Files.Bundle.wxs" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>
</Project>
