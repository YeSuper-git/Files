<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
      Name="$(var.ProductName)"
      Manufacturer="YeSuper"
      Version="$(var.AppVersion)"
      UpgradeCode="C28D12A9-6AE7-4CF5-AB83-4B48FC7A4E6A"
      IconSourceFile="$(var.IconFile)"
      Compressed="yes">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLargeLicense"
          ThemeFile="Files-Setup.Theme.xml"
          LocalizationFile="Files-Setup.zh-CN.wxl"
          LogoFile="$(var.LogoFile)"
          LicenseUrl=""
          SuppressOptionsUI="no"
          SuppressRepair="no"
          ShowVersion="yes"
          LaunchTarget="[InstallFolder]\Files.exe"
          LaunchWorkingFolder="[InstallFolder]" />
      <Payload Name="files-max.ico" SourceFile="$(var.IconFile)" Compressed="yes" />
    </BootstrapperApplication>

    <!-- WixStdBA exposes this persisted variable on its Options page. The
         selected value is explicitly passed to the MSI so both layers agree
         on the same install directory. -->
    <Variable
        Name="EulaAcceptCheckbox"
        Type="numeric"
        Value="0"
        Persisted="no" />

    <Variable
        Name="InstallFolder"
        Type="formatted"
        Value="[ProgramFiles64Folder]Files max"
        bal:Overridable="yes"
        Persisted="yes" />

    <!-- Prefer the path recorded by the MSI, then fall back to the legacy
         NSIS registration when migrating an older installation. Burn runs
         these searches before it removes the related older bundle. -->
    <util:RegistrySearch
        Id="PreviousInstallFolderSearch"
        Root="HKLM"
        Key="Software\YeSuper\Files"
        Value="InstallLocation"
        Variable="PreviousInstallFolder"
        Result="value"
        Bitness="always64" />

    <util:RegistrySearch
        Id="LegacyInstallFolderSearch"
        Root="HKLM"
        Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Files"
        Value="InstallLocation"
        Variable="LegacyInstallFolder"
        Result="value"
        Bitness="always64" />

    <SetVariable
        Id="UsePreviousInstallFolder"
        Variable="InstallFolder"
        Type="string"
        Value="[PreviousInstallFolder]"
        Condition="NOT WixBundleInstalled AND PreviousInstallFolder"
        After="PreviousInstallFolderSearch" />

    <SetVariable
        Id="UseLegacyInstallFolder"
        Variable="InstallFolder"
        Type="string"
        Value="[LegacyInstallFolder]"
        Condition="NOT WixBundleInstalled AND NOT PreviousInstallFolder AND LegacyInstallFolder"
        After="LegacyInstallFolderSearch" />

    <util:RegistrySearch
        Id="VCRedistInstalled"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
        Value="Installed"
        Variable="VCRedistInstalled"
        Result="value"
        Bitness="always64" />

    <Chain>
      <ExePackage
          Id="VCRedist"
          DisplayName="Microsoft Visual C++ Redistributable"
          SourceFile="$(var.VCRedistPath)"
          InstallArguments="/install /quiet /norestart"
          DetectCondition="VCRedistInstalled"
          InstallCondition="VersionNT64"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes" />
      <MsiPackage
          Id="FilesInstallerMsi"
          DisplayName="Files max"
          SourceFile="$(var.MsiPath)"
          Vital="yes">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
