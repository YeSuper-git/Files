<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
      Name="$(var.ProductName)"
      Manufacturer="YeSuper"
      Version="$(var.AppVersion)"
      UpgradeCode="C28D12A9-6AE7-4CF5-AB83-4B48FC7A4E6A"
      IconSourceFile="$(var.IconFile)"
      Compressed="yes">

    <!-- The custom WPF bootstrapper owns the complete wizard surface. This
         keeps Burn's reliable install engine and MSI chain, while replacing
         WixStdBA's native controls with the exact Files max design. The BA is
         published self-contained and its runtime payloads are embedded into
         the one final setup executable. -->
    <BootstrapperApplication SourceFile="$(var.BootstrapperApplicationPath)">
      <PayloadGroupRef Id="FilesMaxBootstrapperPayloads" />
    </BootstrapperApplication>

    <!-- WixStdBA exposes this persisted variable on its Options page. The
         selected value is explicitly passed to the MSI so both layers agree
         on the same install directory. -->
    <Variable
        Name="EulaAcceptCheckbox"
        Type="numeric"
        Value="0"
        Persisted="no" />

    <Variable
        Name="InstallFolder"
        Type="formatted"
        Value="[ProgramFiles64Folder]Files max"
        bal:Overridable="yes"
        Persisted="yes" />

    <!-- Prefer the path recorded by the MSI, then fall back to the legacy
         NSIS registration when migrating an older installation. The legacy
         installer was 32-bit, so search both registry views; otherwise a
         previous Files installation can be missed on a 64-bit Windows host. -->
    <util:RegistrySearch
        Id="PreviousInstallFolderSearch64"
        Root="HKLM"
        Key="Software\YeSuper\Files"
        Value="InstallLocation"
        Variable="PreviousInstallFolder64"
        Result="value"
        Bitness="always64" />

    <util:RegistrySearch
        Id="PreviousInstallFolderSearch32"
        Root="HKLM"
        Key="Software\YeSuper\Files"
        Value="InstallLocation"
        Variable="PreviousInstallFolder32"
        Result="value"
        Bitness="always32" />

    <util:RegistrySearch
        Id="LegacyInstallFolderSearch64"
        Root="HKLM"
        Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Files"
        Value="InstallLocation"
        Variable="LegacyInstallFolder64"
        Result="value"
        Bitness="always64" />

    <util:RegistrySearch
        Id="LegacyInstallFolderSearch32"
        Root="HKLM"
        Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Files"
        Value="InstallLocation"
        Variable="LegacyInstallFolder32"
        Result="value"
        Bitness="always32" />

    <SetVariable
        Id="UsePreviousInstallFolder64"
        Variable="InstallFolder"
        Type="string"
        Value="[PreviousInstallFolder64]"
        Condition="NOT WixBundleInstalled AND PreviousInstallFolder64"
        After="PreviousInstallFolderSearch64" />

    <SetVariable
        Id="UsePreviousInstallFolder32"
        Variable="InstallFolder"
        Type="string"
        Value="[PreviousInstallFolder32]"
        Condition="NOT WixBundleInstalled AND NOT PreviousInstallFolder64 AND PreviousInstallFolder32"
        After="PreviousInstallFolderSearch32" />

    <SetVariable
        Id="UseLegacyInstallFolder64"
        Variable="InstallFolder"
        Type="string"
        Value="[LegacyInstallFolder64]"
        Condition="NOT WixBundleInstalled AND NOT PreviousInstallFolder64 AND NOT PreviousInstallFolder32 AND LegacyInstallFolder64"
        After="LegacyInstallFolderSearch64" />

    <SetVariable
        Id="UseLegacyInstallFolder32"
        Variable="InstallFolder"
        Type="string"
        Value="[LegacyInstallFolder32]"
        Condition="NOT WixBundleInstalled AND NOT PreviousInstallFolder64 AND NOT PreviousInstallFolder32 AND NOT LegacyInstallFolder64 AND LegacyInstallFolder32"
        After="LegacyInstallFolderSearch32" />

    <util:RegistrySearch
        Id="VCRedistInstalled"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
        Value="Installed"
        Variable="VCRedistInstalled"
        Result="value"
        Bitness="always64" />

    <Chain>
      <ExePackage
          Id="VCRedist"
          DisplayName="Microsoft Visual C++ Redistributable"
          SourceFile="$(var.VCRedistPath)"
          InstallArguments="/install /quiet /norestart"
          DetectCondition="VCRedistInstalled"
          InstallCondition="VersionNT64"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes" />
      <MsiPackage
          Id="FilesInstallerMsi"
          DisplayName="Files max"
          SourceFile="$(var.MsiPath)"
          Vital="yes">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
