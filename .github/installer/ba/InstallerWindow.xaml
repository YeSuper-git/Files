<!-- The native WPF resize grip draws outside the transparent window mask
     and creates the diagonal artifact at the lower-right corner. The
     installer keeps its fixed wizard size and uses the custom title-bar
     maximize button instead. -->
<Window x:Class="FilesMax.Installer.Bootstrapper.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FilesMax.Installer.Bootstrapper"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="705"
        Height="556"
        MinWidth="705"
        MinHeight="498"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#F7F9FC"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="True"
        Title="Files max 安装程序"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <!-- Keep resize hit testing without WPF's visible diagonal grip. The
             title bar remains application-owned and is dragged explicitly. -->
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <FontFamily x:Key="InstallerFontFamily">Microsoft YaHei UI</FontFamily>
        <local:ProgressWidthConverter x:Key="ProgressWidthConverter" />

        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="FontFamily" Value="{StaticResource InstallerFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D2DAE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                ClipToBounds="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#F0F5FF" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#9CB6EE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E4EDFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#F7F9FC" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#E1E6EF" />
                                <Setter Property="Foreground" Value="#9AA3B1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" BasedOn="{StaticResource SecondaryButtonStyle}" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2F67E8" />
            <Setter Property="BorderBrush" Value="#2F67E8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                ClipToBounds="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#2458C9" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#2458C9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E8EDF5" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#E8EDF5" />
                                <Setter Property="Foreground" Value="#9AA3B1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="TitleButtonSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonSurface" Property="Background" Value="#E9EEF6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" BasedOn="{StaticResource TitleBarButtonStyle}" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseButtonSurface" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseButtonSurface" Property="Background" Value="#D9535B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="51" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource InstallerFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                ClipToBounds="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxSurface" Property="BorderBrush" Value="#6C8FDD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathButtonStyle" BasedOn="{StaticResource SecondaryButtonStyle}" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="51" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="LicenseCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="FontFamily" Value="{StaticResource InstallerFontFamily}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckSurface"
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,10,0"
                                    CornerRadius="4"
                                    BorderThickness="1.5"
                                    BorderBrush="#9BA7B8"
                                    Background="#FFFFFF">
                                <Path x:Name="CheckMark"
                                      Data="M3,10 L8,15 L17,5"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="#2F67E8" />
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#2F67E8" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#6C8FDD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="#E7ECF4" />
            <Setter Property="Foreground" Value="#2F67E8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid>
                                <Border x:Name="Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="6">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterFrame"
            Background="#F7F9FC"
            BorderBrush="#D1D9E6"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="51" />
                <RowDefinition Height="149" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#F7F9FC"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24"
                            Height="24"
                            Margin="0,0,8,0"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Image Width="24"
                               Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               Source="/FilesMax.Installer.Bootstrapper;component/Assets/FilesSiameseCatLogo.png" />
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#4B5563"
                               FontFamily="{StaticResource InstallerFontFamily}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="Files max 安装程序" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Style="{StaticResource TitleBarButtonStyle}">
                        <Path Width="12" Height="12" Data="M1,9 L11,9" Stroke="#657083" StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="MaximizeButton" Click="MaximizeButton_Click" Style="{StaticResource TitleBarButtonStyle}">
                        <Path x:Name="MaximizeIcon"
                              Width="12"
                              Height="12"
                              Data="M4,9 L10,3 M6,3 H10 V7 M2,6 V11 H7"
                              Stroke="#657083"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click" Style="{StaticResource CloseTitleBarButtonStyle}">
                        <Path Width="12" Height="12" Data="M2,2 L10,10 M10,2 L2,10" Stroke="#657083" StrokeThickness="1.4" />
                    </Button>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Background="#E1E7F0" IsHitTestVisible="False" />
            </Grid>

            <Grid Grid.Row="1" Margin="40,0,40,0">
                <Border Width="84"
                        Height="84"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0,32,0,0"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Image Width="84"
                           Height="84"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           Source="/FilesMax.Installer.Bootstrapper;component/Assets/FilesSiameseCatLogo.png" />
                </Border>
                <StackPanel Margin="108,35,0,0" VerticalAlignment="Top">
                    <TextBlock Foreground="#111827"
                               FontFamily="{StaticResource InstallerFontFamily}"
                               FontSize="38"
                               FontWeight="SemiBold"
                               Text="Files max" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="#6B7280"
                               FontFamily="{StaticResource InstallerFontFamily}"
                               FontSize="21"
                               Text="Windows 安装程序" />
                </StackPanel>
            </Grid>

            <Border x:Name="ContentCard"
                    Grid.Row="2"
                    Height="190"
                    Margin="40,0,40,0"
                    Background="#FFFFFF"
                    BorderBrush="#D8DEE9"
                    BorderThickness="1"
                    CornerRadius="14"
                    ClipToBounds="True">
                <Grid Margin="28">
                    <Grid x:Name="WelcomePage">
                        <StackPanel>
                            <TextBlock Foreground="#111827" FontFamily="{StaticResource InstallerFontFamily}" FontSize="26" FontWeight="SemiBold" Text="欢迎" />
                            <TextBlock Margin="0,13,0,0"
                                       Foreground="#4B5563"
                                       FontFamily="{StaticResource InstallerFontFamily}"
                                       FontSize="16"
                                       TextWrapping="Wrap"
                                       Text="安装程序将在电脑上安装 Files max。点击“下一步”继续，或点击“取消”退出。" />
                            <TextBlock x:Name="WelcomeVersionText"
                                       Margin="0,20,0,0"
                                       Foreground="#6B7280"
                                       FontFamily="{StaticResource InstallerFontFamily}"
                                       FontSize="14"
                                       Text="版本" />
                            <CheckBox x:Name="LicenseCheckBox"
                                      Margin="0,13,0,0"
                                      Checked="LicenseCheckBox_Changed"
                                      Unchecked="LicenseCheckBox_Changed"
                                      Content="我同意许可条款和条件"
                                      Style="{StaticResource LicenseCheckBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="OptionsPage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Foreground="#111827" FontFamily="{StaticResource InstallerFontFamily}" FontSize="26" FontWeight="SemiBold" Text="安装选项" />
                            <TextBlock Margin="0,17,0,0" Foreground="#4B5563" FontFamily="{StaticResource InstallerFontFamily}" FontSize="16" Text="安装位置：" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="74" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallFolderTextBox" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" TextChanged="InstallFolderTextBox_TextChanged" />
                                <Button x:Name="BrowseButton" Grid.Column="2" Content="浏览" Click="BrowseButton_Click" Style="{StaticResource PathButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ProgressPage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ProgressHeaderText"
                                       Foreground="#111827"
                                       FontFamily="{StaticResource InstallerFontFamily}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Text="安装进度" />
                            <TextBlock x:Name="ProgressMessageText"
                                       Margin="0,18,0,0"
                                       Foreground="#4B5563"
                                       FontFamily="{StaticResource InstallerFontFamily}"
                                       FontSize="15"
                                       Text="正在准备安装……" />
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="InstallProgressBar"
                                             Grid.Column="0"
                                             Maximum="100"
                                             Style="{StaticResource ModernProgressBarStyle}" />
                                <TextBlock x:Name="ProgressPercentText"
                                           Grid.Column="1"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#6B7280"
                                           FontFamily="{StaticResource InstallerFontFamily}"
                                           FontSize="14"
                                           Text="0%" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="CompletePage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="CompleteHeaderText" Foreground="#111827" FontFamily="{StaticResource InstallerFontFamily}" FontSize="26" FontWeight="SemiBold" Text="安装成功" />
                            <TextBlock x:Name="CompleteDescriptionText" Margin="0,18,0,0" Foreground="#4B5563" FontFamily="{StaticResource InstallerFontFamily}" FontSize="15" Text="Files max 已经安装完成。" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FailurePage" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="FailureHeaderText"
                                       Foreground="#111827"
                                       FontFamily="{StaticResource InstallerFontFamily}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Text="安装失败" />
                            <ScrollViewer Grid.Row="1"
                                          Margin="0,18,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="FailureMessageText"
                                           Foreground="#4B5563"
                                           FontFamily="{StaticResource InstallerFontFamily}"
                                           FontSize="14"
                                           LineHeight="22"
                                           TextWrapping="Wrap"
                                           Text="安装程序遇到问题，请查看日志后重试。" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="40,0,40,24">
                <StackPanel x:Name="WelcomeActions" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button x:Name="NextButton" Content="下一步" Click="NextButton_Click" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" />
                    <Button x:Name="WelcomeCancelButton" Content="取消" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
                </StackPanel>

                <StackPanel x:Name="OptionsActions" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="BackButton" Content="上一步" Click="BackButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="InstallButton" Content="安装" Click="InstallButton_Click" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
                    <Button x:Name="OptionsCancelButton" Content="取消" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
                </StackPanel>

                <StackPanel x:Name="ModifyActions" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="RepairButton" Content="修复" Click="RepairButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="UninstallButton" Content="卸载" Click="UninstallButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="ModifyCancelButton" Content="取消" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
                </StackPanel>

                <StackPanel x:Name="ProgressActions" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="ProgressCancelButton" Content="取消" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
                </StackPanel>

                <StackPanel x:Name="CompleteActions" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="LaunchButton" MinWidth="112" Content="启动并关闭" Click="LaunchButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="CompleteCloseButton" Content="仅关闭" Click="CompleteCloseButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
                </StackPanel>

                <StackPanel x:Name="FailureActions" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="FailureCloseButton" Content="关闭" Click="CompleteCloseButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
