<Window x:Class="FilesMax.Installer.Bootstrapper.InstallerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:FilesMax.Installer.Bootstrapper"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Width="720" Height="560" MinWidth="720" MinHeight="560"
	WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
	AllowsTransparency="False" Background="#F7F9FC"
	FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#202938" Language="zh-CN"
	TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto"
	UseLayoutRounding="True" SnapsToDevicePixels="True" ShowInTaskbar="True"
	Title="Files max 安装程序" SizeChanged="Window_SizeChanged" Closing="Window_Closing">
	<shell:WindowChrome.WindowChrome>
		<!-- DWM owns the outer contour; content must not draw a second rounded frame. -->
		<shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0"
			GlassFrameThickness="0" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<FontFamily x:Key="InstallerFontFamily">Microsoft YaHei UI</FontFamily>
		<SolidColorBrush x:Key="AccentBrush" Color="#2864DC" />
		<SolidColorBrush x:Key="TextBrush" Color="#202938" />
		<SolidColorBrush x:Key="MutedTextBrush" Color="#657083" />
		<SolidColorBrush x:Key="LineBrush" Color="#E1E6EE" />
		<local:ProgressWidthConverter x:Key="ProgressWidthConverter" />
		<Style x:Key="KeyboardFocusStyle" TargetType="Control">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate>
						<Border Margin="-3" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="8" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="SecondaryButtonStyle" TargetType="Button">
			<Setter Property="MinWidth" Value="88" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Margin" Value="0,0,8,0" />
			<Setter Property="Padding" Value="16,0" />
			<Setter Property="FontFamily" Value="{StaticResource InstallerFontFamily}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource TextBrush}" />
			<Setter Property="Background" Value="White" />
			<Setter Property="BorderBrush" Value="#D4DBE5" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
								TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding FontSize}"
								TextElement.FontWeight="{TemplateBinding FontWeight}" TextElement.Foreground="{TemplateBinding Foreground}" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#F2F5FA" />
					<Setter Property="BorderBrush" Value="#BDC8D8" />
				</Trigger>
				<Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#E8EDF5" /></Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="#F0F3F8" />
					<Setter Property="BorderBrush" Value="#E5E9F0" />
					<Setter Property="Foreground" Value="#919BAC" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
			<Setter Property="MinWidth" Value="96" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Background" Value="{StaticResource AccentBrush}" />
			<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#2158C5" />
					<Setter Property="BorderBrush" Value="#2158C5" />
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Background" Value="#1B4AAA" />
					<Setter Property="BorderBrush" Value="#1B4AAA" />
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="#E8EDF5" />
					<Setter Property="BorderBrush" Value="#E8EDF5" />
					<Setter Property="Foreground" Value="#919BAC" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="TitleBarButtonStyle" TargetType="Button">
			<Setter Property="Width" Value="46" />
			<Setter Property="Height" Value="36" />
			<Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="4">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E9EEF6" /></Trigger>
				<Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DDE5F0" /></Trigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#C42B32" />
					<Setter Property="Foreground" Value="White" />
				</Trigger>
				<Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#A92128" /></Trigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="HeadingStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="24" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource TextBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style x:Key="BodyStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="LineHeight" Value="23" />
		</Style>
		<Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
			<Setter Property="Height" Value="40" />
			<Setter Property="Padding" Value="12,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontFamily" Value="{StaticResource InstallerFontFamily}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Foreground" Value="{StaticResource TextBrush}" />
			<Setter Property="Background" Value="White" />
			<Setter Property="BorderBrush" Value="#CDD6E3" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="TextBoxSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
							<ScrollViewer x:Name="PART_ContentHost" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBoxSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="PathButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
			<Setter Property="Height" Value="40" />
			<Setter Property="Margin" Value="0" />
		</Style>
		<Style x:Key="LicenseCheckBoxStyle" TargetType="CheckBox">
			<Setter Property="FontFamily" Value="{StaticResource InstallerFontFamily}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="MinHeight" Value="32" />
			<Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<Border Background="Transparent">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Border x:Name="CheckSurface" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
									CornerRadius="4" BorderThickness="1" BorderBrush="#94A1B4" Background="White">
									<Path x:Name="CheckMark" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
										Data="M1,6 L4.5,9.5 L11,2.5" Stroke="White" StrokeThickness="1.7"
										StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
								</Border>
								<ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"
									TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.Foreground="{TemplateBinding Foreground}" />
							</StackPanel>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource AccentBrush}" />
								<Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
								<Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
			<Setter Property="Height" Value="6" />
			<Setter Property="Background" Value="#E8EDF5" />
			<Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ProgressBar">
						<Border Background="{TemplateBinding Background}" CornerRadius="3">
							<Border HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3">
								<Border.Width>
									<MultiBinding Converter="{StaticResource ProgressWidthConverter}">
										<Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
										<Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum" />
										<Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth" />
									</MultiBinding>
								</Border.Width>
							</Border>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Border x:Name="OuterFrame" Background="#F7F9FC" BorderBrush="#D1D9E6" BorderThickness="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="44" /><RowDefinition Height="124" /><RowDefinition Height="*" /><RowDefinition Height="84" />
			</Grid.RowDefinitions>
			<Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
				<TextBlock Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="Files max 安装程序" />
				<StackPanel Margin="0,4,6,4" HorizontalAlignment="Right" Orientation="Horizontal">
					<Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Style="{StaticResource TitleBarButtonStyle}" ToolTip="最小化" AutomationProperties.Name="最小化">
						<Path Width="12" Height="12" Data="M1,6 L11,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
					</Button>
					<Button x:Name="CloseButton" Click="CloseButton_Click" Style="{StaticResource CloseTitleBarButtonStyle}" ToolTip="关闭" AutomationProperties.Name="关闭">
						<Path Width="12" Height="12" Data="M2,2 L10,10 M10,2 L2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
					</Button>
				</StackPanel>
			</Grid>
			<Grid Grid.Row="1" Margin="32,0">
				<Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
				<Border Width="64" Height="64" VerticalAlignment="Center" CornerRadius="14" ClipToBounds="True" Background="#909CD4">
					<Image Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"
						Source="/FilesMax.Installer.Bootstrapper;component/Assets/FilesSiameseCatLogo.png" />
				</Border>
				<StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
					<TextBlock FontSize="30" FontWeight="SemiBold" Text="Files max" />
					<TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Windows 安装程序" />
				</StackPanel>
			</Grid>
			<Border x:Name="ContentCard" Grid.Row="2" Margin="32,0,32,0" Padding="28"
				Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
				<Grid>
					<Grid x:Name="WelcomePage">
						<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
						<StackPanel>
							<TextBlock Style="{StaticResource HeadingStyle}" Text="欢迎使用 Files max" />
							<TextBlock Margin="0,12,0,0" Style="{StaticResource BodyStyle}" Text="即将在这台电脑上安装 Files max。&#x0a;请先确认许可条款，再选择安装位置。" />
						</StackPanel>
						<StackPanel Grid.Row="2">
							<TextBlock x:Name="WelcomeVersionText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="版本" />
							<Border Margin="0,12,0,8" Height="1" Background="{StaticResource LineBrush}" />
							<CheckBox x:Name="LicenseCheckBox" HorizontalAlignment="Left" Checked="LicenseCheckBox_Changed" Unchecked="LicenseCheckBox_Changed"
								Content="我同意许可条款和条件" Style="{StaticResource LicenseCheckBoxStyle}" />
						</StackPanel>
					</Grid>
					<Grid x:Name="OptionsPage" Visibility="Collapsed">
						<StackPanel>
							<TextBlock Style="{StaticResource HeadingStyle}" Text="安装选项" />
							<TextBlock Margin="0,12,0,0" Style="{StaticResource BodyStyle}" Text="选择 Files max 的安装位置。" />
							<TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="安装位置" />
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
								<TextBox x:Name="InstallFolderTextBox" Style="{StaticResource ModernTextBoxStyle}" TextChanged="InstallFolderTextBox_TextChanged"
									AutomationProperties.Name="安装位置" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
								<Button x:Name="BrowseButton" Grid.Column="2" Content="浏览…" Click="BrowseButton_Click" Style="{StaticResource PathButtonStyle}" />
							</Grid>
						</StackPanel>
					</Grid>
					<Grid x:Name="ModifyPage" Visibility="Collapsed">
						<StackPanel>
							<TextBlock Style="{StaticResource HeadingStyle}" Text="管理安装" />
							<TextBlock Margin="0,12,0,20" Style="{StaticResource BodyStyle}" Text="这台电脑已安装 Files max，请选择需要的操作。" />
							<TextBlock FontWeight="SemiBold" Text="修复应用" />
							<TextBlock Margin="0,4,0,16" Style="{StaticResource BodyStyle}" Text="修复缺失或损坏的安装组件。" />
							<TextBlock FontWeight="SemiBold" Text="卸载应用" />
							<TextBlock Margin="0,4,0,0" Style="{StaticResource BodyStyle}" Text="从这台电脑移除 Files max。" />
						</StackPanel>
					</Grid>
					<Grid x:Name="ProgressPage" Visibility="Collapsed">
						<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
						<StackPanel>
							<TextBlock x:Name="ProgressHeaderText" Style="{StaticResource HeadingStyle}" Text="正在安装" />
							<TextBlock x:Name="ProgressMessageText" Margin="0,12,0,0" Style="{StaticResource BodyStyle}" Text="正在准备安装……" />
						</StackPanel>
						<StackPanel Grid.Row="2">
							<DockPanel Margin="0,0,0,12">
								<TextBlock DockPanel.Dock="Right" x:Name="ProgressPercentText" HorizontalAlignment="Right" FontWeight="SemiBold" Text="0%" />
								<TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="请稍候，操作完成后会自动显示结果" />
							</DockPanel>
							<ProgressBar x:Name="InstallProgressBar" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" AutomationProperties.Name="操作进度" />
						</StackPanel>
					</Grid>
					<Grid x:Name="CompletePage" Visibility="Collapsed">
						<StackPanel VerticalAlignment="Center">
							<Border Width="40" Height="40" HorizontalAlignment="Left" Background="#E9F5EE" CornerRadius="20">
								<Path Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M2,10 L8,16 L18,4"
									Stroke="#26804D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
							</Border>
							<TextBlock x:Name="CompleteHeaderText" Margin="0,16,0,0" Style="{StaticResource HeadingStyle}" Text="安装完成" />
							<TextBlock x:Name="CompleteDescriptionText" Margin="0,12,0,0" Style="{StaticResource BodyStyle}" Text="Files max 已安装完成，可以开始使用了。" />
						</StackPanel>
					</Grid>
					<Grid x:Name="FailurePage" Visibility="Collapsed">
						<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
						<Grid>
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
							<TextBlock x:Name="FailureHeaderText" Style="{StaticResource HeadingStyle}" Foreground="#B4232D" Text="安装未完成" />
							<Button x:Name="CopyFailureDetailsButton" Grid.Column="1" Content="复制诊断信息" Click="CopyFailureDetailsButton_Click"
								Style="{StaticResource SecondaryButtonStyle}" Margin="0" MinWidth="124" Height="32" FontSize="12" />
						</Grid>
						<TextBlock Grid.Row="1" Margin="0,8,0,12" Style="{StaticResource BodyStyle}" Text="请根据下方原因处理后重试。也可以复制详细信息，方便排查问题。" />
						<Border Grid.Row="2" Background="#F7F9FC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
							<TextBox x:Name="FailureMessageText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource InstallerFontFamily}" FontSize="12" Foreground="#4C596E"
								Background="Transparent" BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
								AutomationProperties.Name="失败详细信息" Text="安装程序遇到问题，请查看日志后重试。" />
						</Border>
					</Grid>
				</Grid>
			</Border>
			<Grid Grid.Row="3" Margin="32,24">
				<TextBlock x:Name="StepText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="第 1 步，共 3 步" />
				<StackPanel x:Name="WelcomeActions" HorizontalAlignment="Right" Orientation="Horizontal">
					<Button x:Name="NextButton" Content="下一步" Click="NextButton_Click" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
					<Button x:Name="WelcomeCancelButton" Content="取消" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
				</StackPanel>
				<StackPanel x:Name="OptionsActions" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="Collapsed">
					<Button x:Name="BackButton" Content="上一步" Click="BackButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
					<Button x:Name="InstallButton" Content="安装" Click="InstallButton_Click" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
					<Button x:Name="OptionsCancelButton" Content="取消" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
				</StackPanel>
				<StackPanel x:Name="ModifyActions" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="Collapsed">
					<Button x:Name="RepairButton" Content="修复" Click="RepairButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
					<Button x:Name="UninstallButton" Content="卸载" Click="UninstallButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
					<Button x:Name="ModifyCancelButton" Content="取消" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
				</StackPanel>
				<StackPanel x:Name="ProgressActions" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="Collapsed">
					<Button x:Name="ProgressCancelButton" Content="取消" Click="CancelButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
				</StackPanel>
				<StackPanel x:Name="CompleteActions" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="Collapsed">
					<Button x:Name="LaunchButton" MinWidth="120" Content="启动并关闭" Click="LaunchButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
					<Button x:Name="CompleteCloseButton" Content="仅关闭" Click="CompleteCloseButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
				</StackPanel>
				<StackPanel x:Name="FailureActions" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="Collapsed">
					<Button x:Name="OpenErrorLogButton" Content="定位错误日志" Click="OpenErrorLogButton_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="120" />
					<Button x:Name="FailureCloseButton" Content="关闭" Click="CompleteCloseButton_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0" />
				</StackPanel>
			</Grid>
		</Grid>
	</Border>
</Window>
