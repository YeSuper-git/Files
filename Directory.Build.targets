<Project>
  <!--
    Windows App SDK currently generates the app PRI for unpackaged builds but
    does not always add it to the dotnet publish item list. Without the PRI,
    WinUI resource dictionaries can fail during startup. Keep this target
    scoped to external-location/unpackaged builds; it can be removed after the
    SDK's unpackaged publish path wires the file itself.
  -->
  <Target Name="FilesAddProjectPriToResolvedFileToPublish"
          Condition="'$(WindowsPackageType)' == 'None'"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             Condition="'$(ProjectPriFullPath)' != '' and Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Unpackaged publish omits compiled XAML pages needed by sparse-package apps. -->
  <Target Name="FilesCopyCompiledXamlToPublishDirectory"
          Condition="'$(WindowsPackageType)' == 'None'"
          AfterTargets="Publish">
    <PropertyGroup>
      <_FilesPublishDirectory>$([MSBuild]::NormalizeDirectory('$(PublishDir)'))</_FilesPublishDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_FilesCompiledXamlForPublish Include="$(TargetDir)**\*.xbf"
                                    Exclude="$(_FilesPublishDirectory)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_FilesCompiledXamlForPublish)"
          DestinationFiles="@(_FilesCompiledXamlForPublish->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
