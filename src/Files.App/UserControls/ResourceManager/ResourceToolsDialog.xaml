<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="Files.App.UserControls.ResourceManager.ResourceToolsDialog"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Border
		Width="400"
		MaxHeight="760"
		Padding="16"
		Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
		BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
		BorderThickness="1"
		CornerRadius="14">
		<Grid RowSpacing="10">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid ColumnSpacing="10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel VerticalAlignment="Center" Spacing="2">
					<TextBlock FontSize="16" FontWeight="SemiBold" Text="格式优化" />
				</StackPanel>
				<Button
					Grid.Column="1"
					Width="32"
					Height="32"
					Padding="0"
					Background="Transparent"
					BorderThickness="0"
					CornerRadius="16"
					Click="Close_Click"
					Content="&#xE8BB;"
					FontFamily="{StaticResource SymbolThemeFontFamily}"
					FontSize="12"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					AutomationProperties.Name="关闭格式优化"
					ToolTipService.ToolTip="关闭" />
			</Grid>

			<ItemsControl
				x:Name="PreviewList"
				Grid.Row="1"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Top"
				ItemsSource="{x:Bind PreviewItems}"
				Visibility="Collapsed">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapGrid ItemWidth="180" Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<TextBlock
							Margin="0,2,8,8"
							FontSize="11"
							Text="{Binding}"
							TextWrapping="WrapWholeWords" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<StackPanel Grid.Row="2" Spacing="10">
				<TextBlock
					x:Name="StatusText"
					Visibility="Collapsed"
					Text=""
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					TextWrapping="WrapWholeWords" />
				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
					<Button
						x:Name="ExecuteButton"
						Padding="10,6"
						Background="{ThemeResource SubtleFillColorSecondaryBrush}"
						BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
						BorderThickness="1"
						IsEnabled="False"
						Click="Execute_Click"
						Content="确认执行"
						CornerRadius="9"
						Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
				</StackPanel>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
