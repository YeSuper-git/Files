<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="Files.App.UserControls.ResourceManager.ResourceToolsDialog"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Border
		x:Name="DialogSurface"
		Padding="0"
		Background="Transparent"
		BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
		BorderThickness="0"
		CornerRadius="14">
		<Grid RowSpacing="10">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid ColumnSpacing="10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel VerticalAlignment="Center" Spacing="2">
					<TextBlock FontSize="16" FontWeight="SemiBold" Text="格式优化" />
				</StackPanel>
				<Button
					x:Name="CloseButton"
					Grid.Column="1"
					Width="36"
					MinWidth="0"
					Margin="0,0,8,0"
					Height="36"
					Padding="0"
					Background="Transparent"
					BorderThickness="0"
					CornerRadius="16"
					Click="Close_Click"
					Content="&#xE8BB;"
					FontFamily="{StaticResource SymbolThemeFontFamily}"
					FontSize="12"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					AutomationProperties.Name="关闭格式优化"
					ToolTipService.ToolTip="关闭" />
			</Grid>

			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
				<StackPanel Spacing="12">
					<StackPanel x:Name="ChoiceGroups" Spacing="12" />
            <ItemsControl
				x:Name="PreviewList"
				Grid.Row="1"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Top"
				ItemsSource="{x:Bind PreviewItems}"
				Visibility="Collapsed">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
                        <Border Padding="16" Margin="0,0,0,12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock FontSize="14" LineHeight="24" Text="{Binding}" TextWrapping="WrapWholeWords" />
                        </Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
				</StackPanel>
            </ScrollViewer>

			<StackPanel Grid.Row="2" Spacing="10">
				<TextBlock
					x:Name="StatusText"
					Visibility="Collapsed"
					Text=""
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					TextWrapping="WrapWholeWords" />
				<Grid Margin="0,12,8,8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="SelectionButtons" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SelectAllButton" Click="SelectAll_Click" />
                        <Button x:Name="SelectNoneButton" Click="SelectNone_Click" />
                    </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
					<Button
						x:Name="ExecuteButton"
						Padding="16,8"
						Background="{ThemeResource AccentFillColorDefaultBrush}"
						BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
						BorderThickness="1"
						IsEnabled="False"
						Click="Execute_Click"
						Content="确认执行"
						CornerRadius="9"
						Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
				</StackPanel>
                </Grid>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
