<UserControl x:Class="Files.App.UserControls.ResourceManager.AnimeFormatOptimizationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="using:Files.App.Helpers">
 <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{helpers:ResourceString Name=AnimeOptimizationTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CloseButton" Grid.Column="1" Width="36" Height="36" MinWidth="0" Padding="0" Margin="8,0,0,0" Click="Close_Click"/></Grid>
  <Grid x:Name="FunctionOptions" Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
   <Button x:Name="FolderFunction" Tag="0" Click="Function_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12"/>
   <Button x:Name="PosterFunction" Grid.Column="1" Tag="1" Click="Function_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12"/>
   <Button x:Name="IllustrationFunction" Grid.Column="2" Tag="2" Click="Function_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12"/>
  </Grid>
  <ScrollViewer x:Name="PreviewScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PreviewRows" Spacing="8"/></ScrollViewer>
  <Grid x:Name="PreviewFooter" Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
   <StackPanel x:Name="SelectionButtons" Visibility="Collapsed" Orientation="Horizontal" Spacing="8"><Button x:Name="SelectAllButton" Content="{helpers:ResourceString Name=ResourceOptimizationSelectAll}" Click="SelectAll_Click"/><Button x:Name="SelectNoneButton" Content="{helpers:ResourceString Name=ResourceOptimizationSelectNone}" Click="SelectNone_Click"/></StackPanel>
   <TextBlock x:Name="StatusText" Grid.Column="1" Text="{helpers:ResourceString Name=ResourceOptimizationChooseFunctions}" TextWrapping="Wrap" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button x:Name="RetryButton" Content="{helpers:ResourceString Name=Retry}" Click="Retry_Click" Visibility="Collapsed"/><Button x:Name="ExecuteButton" Content="{helpers:ResourceString Name=ResourceOptimizationConfirm}" Style="{StaticResource AccentButtonStyle}" Click="Execute_Click" IsEnabled="False"/></StackPanel>
  </Grid>
  <Grid x:Name="CompletionView" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
   <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE73E;" FontSize="28"/><TextBlock Text="{helpers:ResourceString Name=AnimeOptimizationCompleted}" Style="{StaticResource SubtitleTextBlockStyle}"/></StackPanel>
   <TextBlock x:Name="CompletionSummary" Grid.Row="1" TextWrapping="Wrap" HorizontalAlignment="Center"/>
   <ScrollViewer Grid.Row="2"><StackPanel x:Name="CompletionRows" Spacing="8"/></ScrollViewer>
   <Button Grid.Row="3" HorizontalAlignment="Center" Content="{helpers:ResourceString Name=AnimeOptimizationContinue}" Click="Continue_Click"/>
  </Grid>
 </Grid>
</UserControl>
