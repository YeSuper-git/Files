<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="Files.App.UserControls.Assistant.VideoAssistantChatView"
	x:Name="Root"
	 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	 xmlns:vm="using:Files.App.ViewModels.Assistant"
	Loaded="OnViewLoaded"
	Unloaded="OnViewUnloaded"
	d:DesignHeight="620"
	d:DesignWidth="420"
	mc:Ignorable="d">
	<Grid
		DataContext="{x:Bind ViewModel}"
		Padding="16"
		RowSpacing="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid ColumnSpacing="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Border
				Width="36"
				Height="36"
				VerticalAlignment="Center"
				Background="{ThemeResource AccentFillColorDefaultBrush}"
				CornerRadius="10">
				<FontIcon
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
					Glyph="&#xE8D4;" />
			</Border>
			<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
				<TextBlock FontSize="16" FontWeight="SemiBold" Text="视频助手" />
				<TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="只在本机资源库中筛选，不上传文件信息" />
			</StackPanel>
			<Button
				Grid.Column="2"
				Padding="8,4"
				Click="NewConversationButton_Click"
				Content="新对话"
				ToolTipService.ToolTip="开始新的筛选对话" />
			<Button
				Grid.Column="3"
				Width="36"
				Padding="0"
				Click="CloseButton_Click"
				Content="&#xE8BB;"
				FontFamily="{StaticResource SymbolThemeFontFamily}"
				ToolTipService.ToolTip="关闭助手" />		</Grid>

		<ScrollViewer
			Grid.Row="1"
			MaxHeight="105"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<ItemsControl ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapGrid Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:VideoAssistantChoice">
						<Button
							Margin="0,0,6,6"
							Padding="10,5"
							Click="SuggestionButton_Click"
							Content="{x:Bind Label}"
							Tag="{Binding}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<Grid Grid.Row="2">
			<ScrollViewer
				x:Name="MessagesScrollViewer"
				VerticalScrollBarVisibility="Auto">
				<ItemsControl x:Name="MessagesItemsControl" ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:VideoAssistantMessage">
							<StackPanel Margin="0,0,0,12" Spacing="4">
								<TextBlock
									HorizontalAlignment="{x:Bind Alignment}"
									FontSize="11"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="{x:Bind Sender}" />
								<Border
									MaxWidth="520"
									Padding="12,9"
									HorizontalAlignment="{x:Bind Alignment}"
									Background="{ThemeResource SubtleFillColorSecondaryBrush}"
									BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
									BorderThickness="1"
									CornerRadius="12">
									<TextBlock Text="{x:Bind Text}" TextWrapping="WrapWholeWords" />
								</Border>
								<ItemsControl ItemsSource="{x:Bind Results}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:VideoAssistantCandidateViewModel">
											<Border
												Margin="0,4,0,4"
												Padding="8"
												Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
												BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
												BorderThickness="1"
												CornerRadius="10">
												<Grid ColumnSpacing="10">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="64" />
														<ColumnDefinition Width="*" />
													</Grid.ColumnDefinitions>
													<Border
														Width="64"
														Height="88"
														Background="{ThemeResource SubtleFillColorSecondaryBrush}"
														CornerRadius="5">
														<Grid>
															<Image Source="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind PosterVisibility, Mode=OneWay}" />
															<FontIcon Glyph="&#xE8B7;" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
														</Grid>
													</Border>
													<StackPanel Grid.Column="1" Spacing="3">
														<TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
														<TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ActorName}" />
														<TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind WatchStatusText, Mode=OneWay}" />
														<TextBlock FontSize="11" Text="{x:Bind Reason}" TextWrapping="WrapWholeWords" />
														<StackPanel Orientation="Horizontal" Spacing="5">
															<Button Padding="8,4" Click="OpenVideoButton_Click" Content="打开/播放" />
															<Button Padding="8,4" Click="OpenLocationButton_Click" Content="所在位置" />
														</StackPanel>
														<StackPanel Orientation="Horizontal" Spacing="5">
															<Button Padding="8,4" Click="ToggleWatchedButton_Click" Content="{x:Bind WatchButtonText, Mode=OneWay}" />
															<Button Padding="8,4" Click="ToggleWantToWatchButton_Click" Content="{x:Bind WantToWatchButtonText, Mode=OneWay}" />
														</StackPanel>
													</StackPanel>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
			<ProgressRing
				Width="28"
				Height="28"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
		</Grid>

		<StackPanel Grid.Row="3" Spacing="5">
			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBox
					x:Name="MessageInput"
					AcceptsReturn="True"
					MaxHeight="84"
					PlaceholderText="描述你想看的作品，或输入演员名……"
					Text="{x:Bind ViewModel.Draft, Mode=TwoWay}"
					TextWrapping="Wrap"
					KeyDown="MessageInput_KeyDown" />
				<Button
					Grid.Column="1"
					MinWidth="72"
					VerticalAlignment="Bottom"
					Click="SendButton_Click"
					Content="发送"
					IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}" />
			</Grid>
			<TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Enter 发送 · Shift+Enter 换行 · 观看状态由你手动标记" />
		</StackPanel>
	</Grid>
</UserControl>
