<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Files.App.Views.ResourceManager.ResourceLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Files.App.ViewModels.ResourceManager"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="资源管理" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="LibraryPathText" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="管理隐藏项" Click="OnManageHiddenActors" />
                <Button Content="更换路径" Click="OnChooseLibrary" />
                <Button Content="资源工具" Click="OnOpenTools" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <ProgressRing x:Name="LoadingRing" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" />
                <GridView
                    x:Name="BrowserGrid"
                    Padding="12"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind BrowserItems, Mode=OneWay}"
                    SelectionChanged="OnBrowserSelectionChanged"
                    SelectionMode="Extended">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Reserve the widest poster card (244px) plus item padding; otherwise ItemsWrapGrid takes the first item's width and clips later video posters. -->
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="252" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResourceBrowserItemViewModel">
                            <Border
                                Width="{x:Bind CardWidth}"
                                Padding="0"
                                DataContext="{x:Bind}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                RightTapped="OnBrowserItemRightTapped"
                                DoubleTapped="OnBrowserItemDoubleTapped">
                                <StackPanel>
                                    <Border Height="{x:Bind PosterHeight}" CornerRadius="10,10,0,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <Image Source="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind PosterVisibility}" />
                                            <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind FallbackVisibility}" />
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,3" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" CornerRadius="5">
                                                <TextBlock Text="{x:Bind KindLabel}" FontSize="12" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Padding="12,10,12,12">
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0" Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{x:Bind Tags, Mode=OneWay}" Visibility="{x:Bind TagListVisibility}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,5,5" Padding="7,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="5">
                                                        <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Text="当前层级没有可展示的资源" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Border
            x:Name="AssistantFloatingPanel"
            Grid.RowSpan="3"
            Width="420"
            Height="600"
            Margin="0,0,0,56"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Visibility="Collapsed" />
        <Button
            Grid.RowSpan="3"
            Margin="0,0,0,0"
            Padding="14,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            Click="OnOpenVideoAssistant"
            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8D4;" />
                <TextBlock Text="视频助手" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
