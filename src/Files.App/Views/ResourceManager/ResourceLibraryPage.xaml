<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Files.App.Views.ResourceManager.ResourceLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:Files.App.Helpers"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="ActorGroupSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}" />
    </Page.Resources>

    <Grid Padding="0" RowDefinitions="Auto,*">
        <StackPanel x:Name="AnimeRootPanel" Orientation="Horizontal" Spacing="12" Padding="16,8" Visibility="Collapsed">
            <Button x:Name="AnimeRootButton" Click="AnimeRoot_Click" />
            <TextBlock x:Name="AnimeRootPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="AnimeHomeHeader" Grid.Row="0" Margin="24,20,24,8" Spacing="6" MaxWidth="1032" Visibility="Collapsed">
                        <TextBlock Text="{helpers:ResourceString Name=AnimeLibraryTitle}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{helpers:ResourceString Name=AnimeLibraryBrowseCategories}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ScrollViewer
                        x:Name="ActorGroupSelector"
                        Grid.Row="0"
                        Margin="16,10,16,0"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        Visibility="Collapsed">
                        <StackPanel x:Name="ActorGroupButtons" Orientation="Horizontal" Spacing="8" />
                    </ScrollViewer>
                    <Grid x:Name="BrowserViewport" Grid.Row="1" SizeChanged="BrowserViewport_SizeChanged">
                    <ProgressRing x:Name="LoadingRing" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" />
                    <GridView
                        x:Name="BrowserGrid"
                        Padding="12"
                        SizeChanged="BrowserGrid_SizeChanged"
                        IsItemClickEnabled="False"
                        ItemsSource="{Binding BrowserItems, Mode=OneWay}"
                        SelectionChanged="OnBrowserSelectionChanged"
                        CanDragItems="True"
                        DragItemsStarting="ResourceVideos_DragItemsStarting"
                        SelectionMode="Extended">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Keep the wider actor portrait cards aligned with each row while leaving room for the larger poster. -->
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="276" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="{Binding CardWidth, Mode=OneWay}"
                                Padding="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                RightTapped="OnBrowserItemRightTapped"
                                DoubleTapped="OnBrowserItemDoubleTapped">
                                <StackPanel>
                                    <Border Height="{Binding PosterHeight, Mode=OneWay}" CornerRadius="10,10,0,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <Image Source="{Binding Poster, Mode=OneWay}" Stretch="{Binding PosterStretch, Mode=OneWay}" Visibility="{Binding PosterVisibility, Mode=OneWay}" />
                                            <FontIcon Glyph="{Binding FallbackGlyph, Mode=OneWay}" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{Binding FallbackVisibility, Mode=OneWay}" />
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,3" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" CornerRadius="5" Visibility="{Binding KindLabelVisibility, Mode=OneWay}">
                                                <TextBlock Text="{Binding KindLabel, Mode=OneWay}" FontSize="12" />
                                            </Border>
                                            <Border
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="10"
                                                Padding="10,5"
                                                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                                CornerRadius="12"
                                                Visibility="{Binding ActorWorkCountVisibility, Mode=OneWay}">
                                                <TextBlock Text="{Binding ActorWorkCountText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                            <ItemsControl
                                                Width="180"
                                                MaxHeight="60"
                                                Margin="8"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                ItemsSource="{Binding PosterTags, Mode=OneWay}"
                                                Visibility="{Binding PosterTagListVisibility, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapGrid HorizontalAlignment="Right" MaximumRowsOrColumns="2" Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="4,0,0,4" Padding="8,4" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                    <StackPanel Padding="14,12,14,14">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="{Binding NameFontSize, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding DescriptionText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" Visibility="{Binding DescriptionVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    </GridView>
                    <Border x:Name="SelectionMarquee" Background="#330078D4" BorderBrush="#0078D4" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.ZIndex="5" />
                    <ScrollViewer x:Name="VideoDetailView" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="24" Spacing="24">
                            <Grid x:Name="VideoDetailLayout" ColumnSpacing="28" SizeChanged="VideoDetailLayout_SizeChanged" RightTapped="OnBrowserItemRightTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="VideoPosterColumn" Width="2*" />
                                    <ColumnDefinition Width="*" MinWidth="260" />
                                    <ColumnDefinition x:Name="VideoInfoColumn" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border x:Name="VideoPosterFrame" Height="400" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12">
                                    <Image x:Name="VideoDetailPoster" Stretch="Uniform" />
                                </Border>
                                <Grid x:Name="VideoDetailInfoPanel" Grid.Column="1" RowSpacing="12" PreviewKeyDown="AnimeEditor_PreviewKeyDown">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12" HorizontalAlignment="Left" Height="44">
                                        <TextBlock x:Name="VideoDetailTitle" MaxWidth="420" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                                        <Button x:Name="DetailTitleAction" Grid.Column="1" VerticalAlignment="Top" Content="{helpers:ResourceString Name=ResourceDetailTranslate}" Click="DetailTitleAction_Click" />
                                    </Grid>
                                    <Grid x:Name="AnimeDetailMetadata" Grid.Row="1" RowSpacing="12" Margin="0,16,0,0" Visibility="Collapsed">
                                        <Grid.Resources>
                                            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                                            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                                            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlStrokeColorDefaultBrush" />
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                        </Grid.Resources>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{helpers:ResourceString Name=AnimeLibraryAirDateLabel}" />
                                            <Grid Height="32">
                                                <TextBlock x:Name="AnimeAirDate" VerticalAlignment="Center" />
                                                <TextBox x:Name="AnimeMonthEditor" Visibility="Collapsed" TextChanged="AnimeMonthEditor_TextChanged" Width="180" HorizontalAlignment="Left" />
                                            </Grid>
                                        </StackPanel>
                                        <Grid Grid.Row="1" RowSpacing="8">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBlock Text="{helpers:ResourceString Name=AnimeLibrarySynopsis}" />
                                            <Border x:Name="AnimeSynopsisFrame" Grid.Row="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8">
                                                <TextBlock x:Name="AnimeSynopsis" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <TextBox x:Name="AnimeSynopsisEditor" Grid.Row="1" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                        </Grid>
                                        <StackPanel Grid.Row="2" Spacing="8">
                                            <TextBlock x:Name="AnimeEditError" Visibility="Collapsed" Text="{helpers:ResourceString Name=AnimeLibraryInvalidMonth}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <ItemsControl ItemsSource="{Binding PosterTags}" Visibility="{Binding PosterTagListVisibility}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate><Border CornerRadius="4" Padding="8,4" Margin="0,0,6,6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="{Binding}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                        <Button Content="{helpers:ResourceString Name=ResourceVideoPlay}" Click="VideoDetailPlay_Click" />
                                        <Button x:Name="AnimeDetailEditButton" MinWidth="52" Content="{helpers:ResourceString Name=AnimeLibraryEditDetails}" Click="AnimeDetailEdit_Click" Visibility="Collapsed" />
                                        <Button x:Name="AnimeDetailCancelButton" Content="{helpers:ResourceString Name=AnimeLibraryCancel}" Click="AnimeMetadataCancel_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="VideoFileInfoPanel" Grid.Column="1" Grid.Row="1" Spacing="12" Margin="0,20,0,0">
                                    <TextBlock Text="{helpers:ResourceString Name=ResourceVideoInfo}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="VideoDetailFileName" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VideoDetailFileSize" />
                                    <TextBlock x:Name="VideoDetailModified" />
                                    <TextBlock x:Name="VideoDetailPath" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="10">
                                <TextBlock Text="{helpers:ResourceString Name=ResourceVideoFiles}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <GridView x:Name="AnimeEpisodeCards" ItemsSource="{Binding BrowserItems, Mode=OneWay}" SelectionMode="Extended" SelectionChanged="VideoFileList_SelectionChanged" Visibility="Collapsed" MaxHeight="580" CanDragItems="True" DragItemsStarting="ResourceVideos_DragItemsStarting">
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="156" ItemHeight="258" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                    <GridView.ItemTemplate><DataTemplate>
                                        <Border Width="132" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" RightTapped="OnBrowserItemRightTapped" DoubleTapped="OnBrowserItemDoubleTapped">
                                            <StackPanel>
                                                <Border Height="198" CornerRadius="8,8,0,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <Grid><Image Source="{Binding Poster}" Stretch="UniformToFill" /><FontIcon Glyph="&#xE714;" FontSize="32" Visibility="{Binding FallbackVisibility}" /></Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Margin="8" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></GridView.ItemTemplate>
                                </GridView>
                                <GridView x:Name="AnimeEpisodeButtons" ItemsSource="{Binding BrowserItems, Mode=OneWay}" SelectionMode="Extended" SelectionChanged="VideoFileList_SelectionChanged" Visibility="Collapsed" MaxHeight="400" CanDragItems="True" DragItemsStarting="ResourceVideos_DragItemsStarting">
                                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="116" ItemHeight="54" /></ItemsPanelTemplate></GridView.ItemsPanel>
                                    <GridView.ItemTemplate><DataTemplate>
                                        <Border Width="100" Height="38" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" RightTapped="OnBrowserItemRightTapped" DoubleTapped="OnBrowserItemDoubleTapped" ToolTipService.ToolTip="{Binding Name}">
                                            <TextBlock Text="{Binding EpisodeLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate></GridView.ItemTemplate>
                                </GridView>
                                <ListView x:Name="VideoFileList" ItemsSource="{Binding BrowserItems, Mode=OneWay}" SelectionMode="Extended" SelectionChanged="VideoFileList_SelectionChanged" MaxHeight="200" CanDragItems="True" DragItemsStarting="ResourceVideos_DragItemsStarting">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border RightTapped="OnBrowserItemRightTapped" DoubleTapped="OnBrowserItemDoubleTapped">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{helpers:ResourceString Name=ResourceVideoIllustrations}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <Button Grid.Column="1" Content="{helpers:ResourceString Name=ResourceVideoAddIllustration}" Click="AddVideoIllustration_Click" />
                                </Grid>
                                <ItemsControl x:Name="VideoIllustrations">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="210" ItemHeight="160" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border DoubleTapped="Illustration_DoubleTapped" Margin="0,0,10,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8"><Image Source="{Binding}" Stretch="UniformToFill" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="VideoIllustrationsEmpty" Text="{helpers:ResourceString Name=ResourceVideoNoIllustration}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Text="暂无" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border
            x:Name="AssistantFloatingPanel" Grid.Row="1"
            Width="420"
            Height="600"
            Margin="0,0,0,56"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Translation="0,0,24"
            Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
        </Border>
        <Button x:Name="AssistantEntry" Grid.Row="1"
            Width="48"
            Height="48"
            MinWidth="48"
            Margin="0,0,12,12"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            BorderThickness="0"
            Click="OnOpenVideoAssistant"
            PointerEntered="AssistantButton_PointerEntered"
            PointerExited="AssistantButton_PointerExited"
            PointerPressed="AssistantButton_PointerPressed"
            PointerReleased="AssistantButton_PointerReleased"
            CornerRadius="24"
            AutomationProperties.Name="小咪"
            ToolTipService.ToolTip="小咪">
            <Ellipse Width="48" Height="48">
                <Ellipse.Fill>
                    <ImageBrush
                        ImageSource="ms-appx:///Assets/AppTiles/Dev/Square44x44Logo.scale-100.png"
                        Stretch="UniformToFill" />
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="AssistantButtonScaleTransform" CenterX="24" CenterY="24" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Button>
    </Grid>
</Page>
