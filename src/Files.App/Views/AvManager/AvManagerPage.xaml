<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Files.App.Views.AvManager.AvManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <!-- Welcome -->
        <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE8B7;" FontSize="48" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="AV 资源管理工作台" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="选择一个本地文件夹作为资源库" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <Button Content="打开资源库" Style="{StaticResource AccentButtonStyle}" Click="OnChooseLibrary" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Main -->
        <Grid x:Name="MainPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="0,0,0,12">
                <Button Content="刷新" Click="OnRefresh" />
                <Button Content="切换" Click="OnChooseLibrary" />
                <Button Content="预览重命名" Click="OnPreviewRename" />
                <Button Content="字幕分类" Click="OnPreviewClassifySubs" />
                <Button Content="撤销" Click="OnUndo" />
                <Button Content="历史" Click="OnHistory" />
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索名称或番号..."  HorizontalAlignment="Stretch" Width="200" Margin="12,0,0,0" TextChanged="OnSearchChanged" />
            </StackPanel>

            <!-- Progress -->
            <ProgressBar x:Name="ScanProgress" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" />

            <!-- Summary cards -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                <StackPanel x:Name="SummaryCards" Orientation="Horizontal" Spacing="8" />
            </ScrollViewer>

            <!-- Filters -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" Margin="0,60,0,0">
                <RadioButton Content="全部" IsChecked="True" Checked="OnFilterChecked" Tag="全部" />
                <RadioButton Content="异常" Checked="OnFilterChecked" Tag="异常" />
                <RadioButton Content="缺视频" Checked="OnFilterChecked" Tag="缺视频" />
                <RadioButton Content="缺海报" Checked="OnFilterChecked" Tag="缺海报" />
                <RadioButton Content="无中字" Checked="OnFilterChecked" Tag="无中字" />
                <RadioButton Content="重复番号" Checked="OnFilterChecked" Tag="重复番号" />
            </StackPanel>

            <!-- Body -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <ListView x:Name="FolderList" Grid.Column="0" SelectionChanged="OnFolderSelected" Padding="0" />
                <Border x:Name="DetailPanel" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="12,0,0,0" Visibility="Collapsed">
                    <ScrollViewer><StackPanel x:Name="DetailContent" Spacing="12" /></ScrollViewer>
                </Border>
            </Grid>

            <!-- Pending ops -->
            <Border x:Name="PendingBar" Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="PendingCountText" VerticalAlignment="Center" />
                        <Button Content="跳过冲突" Click="OnResolveConflict" Tag="skip" />
                        <Button Content="保留两者" Click="OnResolveConflict" Tag="keep_both" />
                        <Button Content="覆盖" Click="OnResolveConflict" Tag="overwrite" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="执行" Style="{StaticResource AccentButtonStyle}" Click="OnExecutePending" />
                        <Button Content="取消" Click="OnCancelPending" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,8,0,0" />
        </Grid>
    </Grid>
</Page>
