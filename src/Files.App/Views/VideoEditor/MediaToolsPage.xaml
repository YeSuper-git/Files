<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Files.App.Views.VideoEditor.MediaToolsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:models="using:Files.App.Services.VideoEditor"
	xmlns:local="using:Files.App.Views.VideoEditor"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<Page.Resources>
		<DataTemplate x:Key="MuxTrackTemplate" x:DataType="local:MuxTrackDisplay">
			<Grid Padding="0,8" ColumnDefinitions="Auto,*" ColumnSpacing="8">
				<FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center" />
				<StackPanel Grid.Column="1" Spacing="4">
					<TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
					<TextBlock Text="{x:Bind Details}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</StackPanel>
			</Grid>
		</DataTemplate>
		<DataTemplate x:Key="MuxQueueTemplate" x:DataType="models:SubtitleMuxJob">
			<Border Padding="10" Margin="0,2,0,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" ContextRequested="MuxJob_ContextRequested">
				<StackPanel Spacing="8">
					<TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FileName}" />
					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}">
						<TextBlock Text="{helpers:ResourceString Name=SubtitleMuxWorking}" FontSize="12" VerticalAlignment="Center" />
						<ProgressBar Grid.Column="1" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}" VerticalAlignment="Center" />
						<TextBlock Grid.Column="2" Text="{x:Bind Percent, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
					</Grid>
					<TextBlock Text="{x:Bind Details, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Visibility="{x:Bind StatusVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Details, Mode=OneWay}" />
				</StackPanel>
			</Border>
		</DataTemplate>
	</Page.Resources>
	<Grid Padding="24" RowDefinitions="Auto,*,Auto" RowSpacing="16">
		<TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}" />
		<Grid x:Name="ArchivePanel" Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="12">
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
				<Button Content="{helpers:ResourceString Name=ArchiveChooseFolder}" Click="ChooseArchiveFolder_Click" />
				<TextBlock x:Name="ArchivePath" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
			</Grid>
			<StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
				<FontIcon Glyph="&#xE7B8;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				<TextBlock Text="{helpers:ResourceString Name=VideoEditorQueueEmpty}" />
			</StackPanel>
		</Grid>

		<Grid x:Name="MuxPanel" Grid.Row="1" Visibility="Collapsed" ColumnDefinitions="*,330" ColumnSpacing="12">
			<Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" AllowDrop="True" DragOver="Mux_DragOver" Drop="Mux_Drop">
				<Grid RowDefinitions="*,Auto" RowSpacing="12" Padding="16">
					<ScrollViewer>
						<StackPanel Spacing="16">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<TextBlock Text="{helpers:ResourceString Name=SubtitleMuxDropHint}" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
								<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
									<Button x:Name="ChooseVideoButton" Content="{helpers:ResourceString Name=SubtitleMuxChooseVideo}" Click="ChooseMuxVideo_Click" />
									<Button x:Name="AddSubtitleButton" Content="{helpers:ResourceString Name=SubtitleMuxAddSubtitles}" Click="AddSubtitles_Click" />
								</StackPanel>
							</Grid>
							<TextBlock x:Name="MuxVideoPath" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=MuxVideoPath}" />
							<ProgressRing x:Name="MuxInputLoading" Width="24" Height="24" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" />
							<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
								<Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
									<StackPanel Spacing="8">
										<TextBlock Text="{helpers:ResourceString Name=SubtitleMuxSourceContent}" FontWeight="SemiBold" FontSize="16" />
										<TextBlock x:Name="SourceSummary" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
										<ListView x:Name="SourceTracks" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource MuxTrackTemplate}" />
										<StackPanel x:Name="MuxWorkspaceEmpty" HorizontalAlignment="Center" Spacing="12" Margin="0,28">
											<FontIcon Glyph="&#xE714;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
											<TextBlock Text="{helpers:ResourceString Name=VideoEditorQueueEmpty}" />
										</StackPanel>
									</StackPanel>
								</Border>
								<Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
									<StackPanel Spacing="8">
										<TextBlock Text="{helpers:ResourceString Name=SubtitleMuxOutputContent}" FontWeight="SemiBold" FontSize="16" />
										<TextBlock x:Name="OutputSummary" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
										<ListView x:Name="OutputTracks" SelectionMode="None" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource MuxTrackTemplate}" />
                                        <StackPanel x:Name="MuxOutputEmpty" HorizontalAlignment="Center" Spacing="12" Margin="0,28">
                                            <FontIcon Glyph="&#xE8F2;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{helpers:ResourceString Name=VideoEditorQueueEmpty}" />
                                        </StackPanel>
									</StackPanel>
								</Border>
							</Grid>
							<Expander x:Name="SubtitleSettings" Header="{helpers:ResourceString Name=SubtitleMuxTracks}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
								<StackPanel x:Name="SubtitleRows" Spacing="8" />
							</Expander>
							<TextBlock x:Name="SubtitleEmpty" Text="{helpers:ResourceString Name=SubtitleMuxNewTrackHint}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
							<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
								<ComboBox x:Name="DefaultSubtitle" Header="{helpers:ResourceString Name=SubtitleMuxDefaultTrack}" HorizontalAlignment="Stretch" SelectionChanged="MuxSelection_Changed" />
								<ComboBox x:Name="SubtitleEncoding" Grid.Column="1" Header="{helpers:ResourceString Name=SubtitleMuxEncoding}" SelectedIndex="0" HorizontalAlignment="Stretch">
									<ComboBoxItem Content="UTF-8" Tag="UTF-8" /><ComboBoxItem Content="GB18030" Tag="GB18030" />
								</ComboBox>
							</Grid>
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<TextBox x:Name="MuxOutputFolder" Header="{helpers:ResourceString Name=SubtitleMuxOutputFolder}" TextChanged="MuxInput_Changed" />
								<Button x:Name="OutputFolderButton" Grid.Column="1" VerticalAlignment="Bottom" Content="{helpers:ResourceString Name=ArchiveChooseDestination}" Click="ChooseOutputFolder_Click" />
							</Grid>
							<TextBox x:Name="MuxOutputName" Header="{helpers:ResourceString Name=SubtitleMuxOutputName}" TextChanged="MuxInput_Changed" />
						</StackPanel>
					</ScrollViewer>
					<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
						<Button Content="{helpers:ResourceString Name=SubtitleMuxReset}" Click="ResetMux_Click" />
						<Button x:Name="MergeButton" Content="{helpers:ResourceString Name=SubtitleMuxStart}" Style="{StaticResource AccentButtonStyle}" Click="MergeSubtitles_Click" IsEnabled="False" />
					</StackPanel>
				</Grid>
			</Border>
			<Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
				<Pivot>
					<PivotItem Header="{helpers:ResourceString Name=SubtitleMuxProcessingQueue}">
						<Grid>
							<ListView ItemsSource="{x:Bind Queue.ProcessingJobs}" SelectionMode="None" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource MuxQueueTemplate}" />
							<StackPanel x:Name="MuxProcessingEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
								<FontIcon Glyph="&#xE823;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{helpers:ResourceString Name=VideoEditorQueueEmpty}" />
							</StackPanel>
						</Grid>
					</PivotItem>
					<PivotItem Header="{helpers:ResourceString Name=VideoEditorCompleted}">
						<Grid>
							<ListView ItemsSource="{x:Bind Queue.CompletedJobs}" SelectionMode="None" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource MuxQueueTemplate}" />
							<StackPanel x:Name="MuxCompletedEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
								<FontIcon Glyph="&#xE930;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{helpers:ResourceString Name=VideoEditorQueueEmpty}" />
							</StackPanel>
						</Grid>
					</PivotItem>
				</Pivot>
			</Border>
		</Grid>

		<TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
	</Grid>
</Page>
