<Page
	x:Class="Files.App.Views.VideoEditor.VideoEditorPage"
	x:Name="EditorPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
	xmlns:video="using:Files.App.Services.VideoEditor"
	d:DesignHeight="760"
	d:DesignWidth="1280"
	mc:Ignorable="d"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<Grid Padding="8">
		<Grid ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" MinWidth="460" />
				<ColumnDefinition Width="330" MinWidth="290" />
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Padding="0" Background="Transparent" BorderThickness="0">
				<Grid RowSpacing="5">
					<Grid.RowDefinitions>
						<RowDefinition Height="*" MinHeight="230" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Grid x:Name="VideoEditorSurface" Grid.Row="0">
						<Grid x:Name="PreviewDropTarget" AllowDrop="True" DragOver="VideoDropTarget_DragOver" Drop="VideoDropTarget_Drop">
							<Border x:Name="VideoPlayerContainer" Background="#111318" CornerRadius="8" Visibility="Collapsed">
								<MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False" AutoPlay="False" />
							</Border>
							<Grid x:Name="EmptyVideoState" Visibility="Visible">
								<Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
									<Grid>
										<Rectangle Margin="6" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.22" StrokeDashArray="7,5" StrokeThickness="2" IsHitTestVisible="False" />
										<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Spacing="12">
											<TextBlock Text="{video:VideoEditorText Name=VideoEditorDropVideo}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
											<TextBlock Text="{video:VideoEditorText Name=VideoEditorNoVideoHint}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
											<Button HorizontalAlignment="Center" Click="OpenVideo_Click" IsEnabled="{x:Bind ViewModel.IsToolchainAvailable, Mode=OneWay}">
												<StackPanel Orientation="Horizontal" Spacing="8">
													<FontIcon Glyph="&#xE8E5;" />
													<TextBlock Text="{video:VideoEditorText Name=VideoEditorOpenVideo}" />
												</StackPanel>
											</Button>
											<ProgressRing x:Name="VideoLoadingIndicator" Width="24" Height="24" HorizontalAlignment="Center" IsActive="False" Visibility="Collapsed" />
										</StackPanel>
									</Grid>
								</Border>
							</Grid>
						</Grid>
					</Grid>

					<Grid Grid.Row="1" ColumnSpacing="10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock Text="{x:Bind ViewModel.CurrentTimeText, Mode=OneWay}" VerticalAlignment="Center" FontFamily="Consolas" />
						<Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" ValueChanged="SeekSlider_ValueChanged" />
						<TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" VerticalAlignment="Center" FontFamily="Consolas" />
					</Grid>

					<Grid Grid.Row="2" RowSpacing="4">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid ColumnSpacing="12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="{video:VideoEditorText Name=VideoEditorKeepRange}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
								<TextBlock Text="{x:Bind ViewModel.TrimStartText, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" />
							</StackPanel>
							<TextBlock Grid.Column="1" Text="—" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
							<TextBlock Grid.Column="2" Text="{x:Bind ViewModel.TrimEndText, Mode=OneWay}" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="SemiBold" />
						</Grid>
						<Canvas x:Name="TimelineCanvas" Grid.Row="1" Height="40" SizeChanged="TimelineCanvas_SizeChanged" PointerPressed="TimelineCanvas_PointerPressed" AutomationProperties.Name="{video:VideoEditorText Name=VideoEditorTimelineHint}">
							<Border x:Name="TimelineTrack" Canvas.Top="16" Height="8" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
							<Border x:Name="SelectedRangeTrack" Canvas.Top="16" Height="8" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" />
							<Rectangle x:Name="PlayheadLine" Width="2" Height="22" Canvas.Top="9" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
							<primitives:Thumb x:Name="TrimStartThumb" Width="14" Height="32" Canvas.Top="4" Background="{ThemeResource AccentFillColorDefaultBrush}"
								DragDelta="TrimStartThumb_DragDelta" DragCompleted="TrimStartThumb_DragCompleted" />
							<primitives:Thumb x:Name="TrimEndThumb" Width="14" Height="32" Canvas.Top="4" Background="{ThemeResource AccentFillColorDefaultBrush}"
								DragDelta="TrimEndThumb_DragDelta" DragCompleted="TrimEndThumb_DragCompleted" />
						</Canvas>
						<TextBlock Grid.Row="2" Text="{video:VideoEditorText Name=VideoEditorTimelineHint}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
					</Grid>

					<StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
						<Button Content="{video:VideoEditorText Name=VideoEditorChangeVideo}" Click="OpenVideo_Click" />
						<Button Content="{video:VideoEditorText Name=VideoEditorCutBefore}" Click="SetTrimStart_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
						<Button Content="{video:VideoEditorText Name=VideoEditorCutAfter}" Click="SetTrimEnd_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
						<Button Content="{video:VideoEditorText Name=VideoEditorRestore}" Click="RestoreTrim_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
						<Button Content="{video:VideoEditorText Name=VideoEditorPresets}" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}">
							<Button.Flyout>
								<Flyout Placement="Top">
									<StackPanel Width="300" MaxHeight="350" Spacing="8">
										<TextBlock Text="{video:VideoEditorText Name=VideoEditorPresets}" FontWeight="SemiBold" />
										<ListView ItemsSource="{x:Bind ViewModel.Presets, Mode=OneWay}" SelectionMode="None">
											<ListView.ItemTemplate>
												<DataTemplate x:DataType="video:VideoCutPreset">
													<StackPanel Orientation="Horizontal" Spacing="6">
														<Button Content="{x:Bind Name}" Click="ApplyPreset_Click" />
														<TextBlock Text="{x:Bind TrimSummary}" VerticalAlignment="Center" />
														<Button Content="×" Click="DeletePreset_Click" />
													</StackPanel>
												</DataTemplate>
											</ListView.ItemTemplate>
										</ListView>
									</StackPanel>
								</Flyout>
							</Button.Flyout>
						</Button>
						<Button Content="{video:VideoEditorText Name=VideoEditorExport}" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}">
							<Button.Flyout>
								<MenuFlyout Placement="Top">
									<MenuFlyoutItem Text="{video:VideoEditorText Name=VideoEditorExportNow}" Click="ExportNow_Click" />
									<MenuFlyoutItem Text="{video:VideoEditorText Name=VideoEditorExportLater}" Click="ExportLater_Click" />
								</MenuFlyout>
							</Button.Flyout>
						</Button>
						<Button Content="{video:VideoEditorText Name=VideoEditorCloseVideo}" Click="CloseVideo_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
					</StackPanel>

					<Grid Grid.Row="4" ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
							<Button Width="38" Click="PreviousKeyframe_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" ToolTipService.ToolTip="{video:VideoEditorText Name=VideoEditorPreviousKeyframe}" AutomationProperties.Name="{video:VideoEditorText Name=VideoEditorPreviousKeyframe}">
								<FontIcon Glyph="&#xE892;" />
							</Button>
							<Button Content="−5s" Click="Rewind_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
							<Button x:Name="PlayButton" Content="{video:VideoEditorText Name=VideoEditorPlay}" Click="PlayPause_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
							<Button Content="+5s" Click="Forward_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" />
							<Button Width="38" Click="NextKeyframe_Click" IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}" ToolTipService.ToolTip="{video:VideoEditorText Name=VideoEditorNextKeyframe}" AutomationProperties.Name="{video:VideoEditorText Name=VideoEditorNextKeyframe}">
								<FontIcon Glyph="&#xE893;" />
							</Button>
						</StackPanel>
						<TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SourceDetails, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
					</Grid>

					<TextBlock Grid.Row="5" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
				</Grid>
			</Border>

			<Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
				<Grid RowSpacing="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" ColumnSpacing="10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock Text="{video:VideoEditorText Name=VideoEditorQueueTitle}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
						<Button x:Name="AllQueueButton" Grid.Column="1" Click="AllQueue_Click" IsEnabled="False" />
					</Grid>

					<Grid Grid.Row="1" ColumnSpacing="4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<ToggleButton x:Name="ProcessingTabButton" Tag="Processing" Click="QueueTab_Click" IsChecked="True" Padding="6,8" HorizontalContentAlignment="Center">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="{video:VideoEditorText Name=VideoEditorProcessing}" />
								<TextBlock x:Name="ProcessingCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
							</StackPanel>
						</ToggleButton>
						<ToggleButton x:Name="CompletedTabButton" Grid.Column="1" Tag="Completed" Click="QueueTab_Click" Padding="6,8" HorizontalContentAlignment="Center">
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock Text="{video:VideoEditorText Name=VideoEditorCompleted}" />
								<TextBlock x:Name="CompletedCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
							</StackPanel>
						</ToggleButton>
					</Grid>

					<Grid Grid.Row="2">
						<Grid x:Name="ProcessingPanel" Visibility="Visible">
							<Grid>
								<ListView ItemsSource="{x:Bind ViewModel.ProcessingJobs, Mode=OneWay}" SelectionMode="None" Padding="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
									<ListView.ItemTemplate>
										<DataTemplate x:DataType="video:VideoCutJob">
											<Border Padding="12" Margin="0,2,0,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
												<StackPanel Spacing="7">
													<Grid ColumnSpacing="8">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="Auto" />
														</Grid.ColumnDefinitions>
														<TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
														<TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
													</Grid>
													<TextBlock Text="{x:Bind TrimSummary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
													<ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="1" />
													<TextBlock Text="{x:Bind ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
													<TextBlock Text="{x:Bind WarningMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
													<StackPanel Orientation="Horizontal" Spacing="8">
												<Button Content="{x:Bind PauseActionText, Mode=OneWay}" Click="PauseResumeJob_Click" IsEnabled="{x:Bind CanPauseResume, Mode=OneWay}" />
												<Button Content="{video:VideoEditorText Name=VideoEditorReedit}" Click="ReeditJob_Click" IsEnabled="{x:Bind CanCancel, Mode=OneWay}" />
												<Button Content="{video:VideoEditorText Name=VideoEditorCancelExport}" Click="CancelJob_Click" IsEnabled="{x:Bind CanCancel, Mode=OneWay}" />
													</StackPanel>
												</StackPanel>
											</Border>
										</DataTemplate>
									</ListView.ItemTemplate>
								</ListView>
								<StackPanel x:Name="ProcessingEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250" Spacing="10" Visibility="Visible">
									<FontIcon Glyph="&#xE823;" FontSize="28" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
									<TextBlock Text="{video:VideoEditorText Name=VideoEditorQueueEmpty}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
								</StackPanel>
							</Grid>
						</Grid>

						<Grid x:Name="CompletedPanel" Visibility="Collapsed">
							<Grid>
								<ListView ItemsSource="{x:Bind ViewModel.CompletedJobs, Mode=OneWay}" SelectionMode="None" Padding="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
									<ListView.ItemTemplate>
										<DataTemplate x:DataType="video:VideoCutJob">
											<Border Padding="12" Margin="0,2,0,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
												<StackPanel Spacing="6">
													<TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
													<TextBlock Text="{x:Bind TrimSummary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
													<TextBlock Text="{x:Bind OutputPath}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
													<TextBlock Text="{x:Bind WarningMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
												</StackPanel>
											</Border>
										</DataTemplate>
									</ListView.ItemTemplate>
								</ListView>
								<StackPanel x:Name="CompletedEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250" Spacing="10" Visibility="Visible">
									<FontIcon Glyph="&#xE73E;" FontSize="28" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
									<TextBlock Text="{video:VideoEditorText Name=VideoEditorCompletedEmpty}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
								</StackPanel>
							</Grid>
						</Grid>

					</Grid>

					<TextBlock x:Name="QueueSummary" Grid.Row="3" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Page>
