<Page
	x:Class="Files.App.Views.Settings.VideoEditorSettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:video="using:Files.App.Services.VideoEditor"
	xmlns:wctcontrols="using:CommunityToolkit.WinUI.Controls">
	<StackPanel Spacing="8">
		<TextBlock Padding="0,0,0,12" Style="{StaticResource App.Theme.SubtitleTextBlockStyle}" Text="{video:VideoEditorText Name=VideoEditorSettingsTitle}" />
		<TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="Medium" Text="{video:VideoEditorText Name=VideoEditorExportGroup}" />
		<wctcontrols:SettingsCard x:Name="SourceLocationCard" Header="{video:VideoEditorText Name=VideoEditorExportLocation}" Description="{video:VideoEditorText Name=VideoEditorExportLocationHint}">
			<wctcontrols:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></wctcontrols:SettingsCard.HeaderIcon>
			<ComboBox x:Name="SourceFolderModeComboBox" Width="240" SelectionChanged="FolderModeComboBox_SelectionChanged">
				<ComboBoxItem Content="{video:VideoEditorText Name=VideoEditorSourceFolderOption}" Tag="Source" />
				<ComboBoxItem Content="{video:VideoEditorText Name=VideoEditorCustomFolderOption}" Tag="Custom" />
			</ComboBox>
		</wctcontrols:SettingsCard>
		<wctcontrols:SettingsExpander x:Name="LocationExpander" Header="{video:VideoEditorText Name=VideoEditorExportLocation}" Description="{video:VideoEditorText Name=VideoEditorExportLocationHint}" IsExpanded="False" Visibility="Collapsed">
			<wctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></wctcontrols:SettingsExpander.HeaderIcon>
			<ComboBox x:Name="FolderModeComboBox" Width="240" SelectionChanged="FolderModeComboBox_SelectionChanged">
				<ComboBoxItem Content="{video:VideoEditorText Name=VideoEditorSourceFolderOption}" Tag="Source" />
				<ComboBoxItem Content="{video:VideoEditorText Name=VideoEditorCustomFolderOption}" Tag="Custom" />
			</ComboBox>
			<wctcontrols:SettingsExpander.ItemsHeader>
				<Grid Padding="20,12,32,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBox x:Name="FolderPathTextBox" Grid.Column="0" IsReadOnly="True" PlaceholderText="{video:VideoEditorText Name=VideoEditorNoFolderSelected}" />
					<Button x:Name="ChooseFolderButton" Grid.Column="1" Content="{video:VideoEditorText Name=VideoEditorChooseFolder}" Click="ChooseFolderButton_Click" />
				</Grid>
			</wctcontrols:SettingsExpander.ItemsHeader>
		</wctcontrols:SettingsExpander>
		<wctcontrols:SettingsExpander Header="{video:VideoEditorText Name=VideoEditorShortcutSettings}" Description="{video:VideoEditorText Name=VideoEditorShortcutHint}" IsExpanded="True">
            <wctcontrols:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE765;" /></wctcontrols:SettingsExpander.HeaderIcon>
            <Button Content="{video:VideoEditorText Name=VideoEditorShortcutDefaults}" Click="RestoreShortcuts_Click" />
            <wctcontrols:SettingsExpander.ItemsHeader>
                <StackPanel Padding="20,12" Spacing="8">
                    <StackPanel x:Name="ShortcutRows" Spacing="8" />
                    <TextBlock x:Name="ShortcutStatus" TextWrapping="Wrap" />
                </StackPanel>
            </wctcontrols:SettingsExpander.ItemsHeader>
        </wctcontrols:SettingsExpander>
        <TextBlock x:Name="FolderStatusText" Margin="48,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
	</StackPanel>
</Page>
